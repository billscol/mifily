# Plantilla de variables de entorno para producción (mifily.com / mifi.uno).
# Copiar como `.env` junto a docker-compose.prod.yml en el servidor
# (/www/wwwroot/mifily/) y rellenar con valores reales. NO commitear ese
# archivo real: docker-compose ya lo lee vía `env_file: .env`.

###############################
###### CORE ######
###############################

# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://app.mifily.com

# Secreto compartido para los cron jobs internos (ver deploy/crontab.template)
CRON_SECRET=

# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

###############################
###### BASE DE DATOS (MariaDB propio del VPS) ######
###############################

# Creada vía aaPanel -> Bases de datos -> Añadir. El contenedor alcanza el
# host por "host.docker.internal" (ver extra_hosts en docker-compose.prod.yml).
DATABASE_URL="mysql://USUARIO:PASSWORD@host.docker.internal:3306/mifily_dub"

###############################
###### UPSTASH (Redis + QStash) ######
###############################

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

###############################
###### TINYBIRD (analytics) ######
###############################

TINYBIRD_API_KEY=
TINYBIRD_API_URL=https://api.tinybird.co

###############################
###### GITHUB OAUTH (login) ######
###############################

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

###############################
###### EMAIL (Amazon SES vía SMTP) ######
###############################

# Si RESEND_API_KEY queda vacío, packages/email cae automáticamente al
# transporte SMTP de abajo (ver packages/email/src/index.ts) - no hace falta
# tocar código. Requisitos en el lado de AWS antes de que esto entregue
# correo de verdad:
#   1. Verificar el dominio "mifily.com" en SES (SPF + los 3 registros CNAME
#      de DKIM que da la consola) - "Verified identities" -> "Create identity".
#   2. Pedir "production access" (sacar la cuenta del sandbox de SES):
#      sin esto solo se puede enviar a direcciones también verificadas
#      manualmente y con tope de 200 emails/día.
#   3. Crear credenciales SMTP dedicadas en SES -> "SMTP settings" ->
#      "Create SMTP credentials" (son distintas del access key de IAM).
# RESEND_API_KEY=

SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

###############################
###### STORAGE (MinIO propio del VPS, vía cdn.mifily.com) ######
###############################

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

STORAGE_ENDPOINT=https://cdn.mifily.com
STORAGE_BASE_URL=https://cdn.mifily.com/mifily-public
STORAGE_PUBLIC_BUCKET=mifily-public
STORAGE_PRIVATE_BUCKET=mifily-private
# Mismos valores que MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

###############################
###### ADMIN PANEL (admin.mifily.com) ######
###############################

# Firma las cookies de sesión del panel admin (login con usuario+contraseña,
# soporta múltiples administradores vía la tabla AdminUser)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Compartido entre el panel admin y la app principal (mismo valor en ambos,
# ya que ambos leen este mismo .env) - protege los endpoints
# /api/admin-internal/* de la app principal.
ADMIN_INTERNAL_SECRET=
